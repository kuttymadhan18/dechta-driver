# ============================================================
# Dechta Driver Backend — Environment Variables
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL — same dechta database as vendor app
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/dechta

# JWT
JWT_SECRET=dechta-driver-super-secret-change-in-production

# OTP Provider: mock (dev) | msg91 (production)
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5

# MSG91 (production SMS)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=DECHTA

# Cloudinary (file uploads — avatars, documents, package photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage bucket names (used as Cloudinary folder prefixes)
STORAGE_BUCKET_AVATARS=driver-avatars
STORAGE_BUCKET_DOCUMENTS=driver-documents
STORAGE_BUCKET_PACKAGE_PHOTOS=package-photos

# Frontend URL (for CORS)
FRONTEND_URL=*
