# ============================================================
# QC DRIVER BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://your-expo-app-url.vercel.app

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT (use a long random secret — min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# OTP Config
# For demo: MOCK mode (logs OTP to console, no SMS sent)
# For production: switch OTP_PROVIDER=msg91 and fill MSG91 keys
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5

# MSG91 (India SMS — fill when going to production)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_SENDER_ID=QCLOGX

# Supabase Storage
STORAGE_BUCKET_AVATARS=driver-avatars
STORAGE_BUCKET_DOCUMENTS=driver-documents
STORAGE_BUCKET_PACKAGE_PHOTOS=package-photos
STORAGE_BUCKET_PROMO=promo-images
